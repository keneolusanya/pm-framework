[Unit]
Description=pm-framework SMS-confirm webhook (FastAPI on 127.0.0.1:8000, behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
User=pm
Group=pm
WorkingDirectory=/opt/pm-framework
EnvironmentFile=/opt/pm-framework/.env
ExecStart=/opt/pm-framework/.venv/bin/uvicorn execute.webhook:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

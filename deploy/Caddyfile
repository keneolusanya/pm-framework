# Caddy reverse proxy for pm-framework. Caddy fetches + renews HTTPS certs
# automatically. Replace the site address below with your real domain, point
# its DNS A record at the server, and set WEBHOOK_PUBLIC_URL in .env to
# https://<your domain>/sms-reply (Twilio signs the public URL).
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

your-domain.example {
    encode gzip

    # Public RSS feed, served as a static file.
    handle /feed.xml {
        root * /opt/pm-framework/dashboard
        file_server
    }

    # Twilio SMS-confirm webhook -> FastAPI (deploy/pm-webhook.service).
    handle /sms-reply {
        reverse_proxy localhost:8000
    }

    # Everything else -> the Streamlit dashboard (deploy/pm-dashboard.service).
    handle {
        reverse_proxy localhost:8501
    }
}

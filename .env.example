# Copy to .env and fill in. .env is gitignored and must never be committed.
# The secrets table in plan.md tracks which day introduces each of these.

# --- Day 3: Claude LLM verification (Stage 3 of the matching pipeline) ---
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-sonnet-5.
VERIFY_MODEL=claude-sonnet-5

# --- Day 1: Kalshi request signing (public reads work without these) ---
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Day 4: Twilio personal SMS alerts + reply webhook ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Day 4: password for the gated trades dashboard page ---
DASHBOARD_PASSWORD=

# --- Day 5: Polymarket order signing (Polygon wallet key) ---
POLYMARKET_PRIVATE_KEY=

# --- Day 4: scanner liquidity / sanity filters (optional; defaults shown) ---
# Skip opportunities where a market is too thin to trust its price. Units differ:
# Polymarket volume is USD, Kalshi is contracts.
SCAN_MIN_VOL_POLY=500
SCAN_MIN_VOL_KALSHI=100
# Gaps larger than this on a verified-same event are quarantined to needs_review
# instead of traded (a huge divergence means the match or a price is wrong).
SCAN_MAX_EDGE=0.25

# --- Day 5: execution controls ---
# Orders dry-run unless EXECUTE_LIVE=1. KALSHI_DEMO=1 uses the demo endpoint.
EXECUTE_LIVE=0
KALSHI_DEMO=1
RISK_MAX_POSITION_USD=25
RISK_DAILY_CAP_USD=200
RISK_KILL_SWITCH=0

# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Claude LLM verification (stage 3 of the matching pipeline) ---
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-sonnet-5. The confidence gates
# below were tuned on Sonnet 5 — re-check them if you switch models.
VERIFY_MODEL=claude-sonnet-5
# Confidence gates for auto-accept / auto-reject. Below either bar -> human
# review. Raise VERIFY_REJECT_CONF to be more cautious about auto-rejecting.
VERIFY_ACCEPT_CONF=0.9
VERIFY_REJECT_CONF=0.9

# --- Kalshi request signing (public reads work without these; orders need them) ---
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Ingestion coverage caps (loops stop early when a platform runs out) ---
# Kalshi scales with this (more events -> more markets, more disk/compute).
INGEST_KALSHI_EVENT_CAP=10000
# Polymarket's Gamma /markets endpoint hard-caps pagination at ~2,000 regardless
# of this value, and we pull those sorted by volume (the most liquid/tradeable),
# so raising it has no effect unless the API ceiling lifts.
INGEST_POLY_MAX=6000

# --- Database ---
# Defaults to db/markets.duckdb. Seconds a process waits for another's lock.
# PM_DB_PATH=
DB_LOCK_WAIT_SEC=120
# Days of price snapshots db/prune.py keeps (matched markets are kept forever).
DB_KEEP_DAYS=3

# --- Twilio personal SMS alerts + reply webhook ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
# The public URL Twilio posts replies to. Needed behind Caddy/TLS, because
# Twilio signs this exact URL: https://<your domain>/sms-reply
WEBHOOK_PUBLIC_URL=

# --- Dashboard ---
# Password for the gated trades page.
DASHBOARD_PASSWORD=
# Public dashboard URL, used in the daily SMS digest and the RSS feed link.
DASHBOARD_URL=

# --- Polymarket order signing (Polygon wallet key) ---
POLYMARKET_PRIVATE_KEY=
# Only if your funds sit in a Polymarket.com account (proxy wallet):
# the account's address, and 1 = email/Magic login, 2 = browser wallet.
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=

# --- Scanner filters (optional; defaults shown) ---
# Skip opportunities where a market is too thin to trust its price. Units differ:
# Polymarket volume is USD, Kalshi is contracts.
SCAN_MIN_VOL_POLY=500
SCAN_MIN_VOL_KALSHI=100
# Gaps larger than this on a verified-same event are quarantined to needs_review
# instead of traded (a huge divergence means the match or a price is wrong).
SCAN_MAX_EDGE=0.25
# Cushion subtracted from every edge for slippage / price moves between legs.
SCAN_SAFETY_MARGIN=0.02
# Share of trusted pairs re-verified by the LLM each scan (~1 cent per pair).
SCAN_AUDIT_FRACTION=0.01

# --- Execution controls ---
# Orders dry-run unless EXECUTE_LIVE=1. KALSHI_DEMO=1 uses the demo endpoint.
EXECUTE_LIVE=0
KALSHI_DEMO=1
# Contracts per leg (Polymarket's usual minimum order is 5 shares).
EXECUTE_CONTRACTS=5
# Refuse to execute if the latest snapshot is older than this.
EXECUTE_MAX_PRICE_AGE_MIN=15
RISK_MAX_POSITION_USD=25
RISK_DAILY_CAP_USD=200
RISK_KILL_SWITCH=0

# --- Metrics ---
# Stake per opportunity for the modeled P&L figure (defaults to RISK_MAX_POSITION_USD).
# MODEL_STAKE_USD=25
